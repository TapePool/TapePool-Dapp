{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm ci --ignore-scripts && npm run build"
  },
  "deploy": {
    "startCommand": "npm start",
    "restartPolicyType": "ALWAYS",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 120
  }
}
